{
  "description": "Jev at four points: after every tool call, before every tool call, at the start of a request, and at the stop.",
  "hooks": {
    "PostToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/jev-hook\"", "timeout": 30}]}
    ],
    "PreToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/jev-hook\"", "timeout": 15}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/jev-hook\"", "timeout": 10}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/jev-hook\"", "timeout": 15}]}
    ]
  }
}
